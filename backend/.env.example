# ==============================================================================
# Backend Environment Configuration Example
# Copy this file to backend/.env and populate your actual secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database & Storage)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 2. LLM Provider (OpenRouter / OpenAI-compatible API)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-your_openrouter_api_key
OPENAI_API_BASE=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. Embeddings (HuggingFace Inference API)
# ------------------------------------------------------------------------------
HUGGINGFACE_API_KEY=hf_your_huggingface_access_token

# ------------------------------------------------------------------------------
# 4. Vector Database (Qdrant)
# ------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=campus_assistant
